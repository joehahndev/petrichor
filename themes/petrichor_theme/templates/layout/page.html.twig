{#
/**
 * @file
 * Theme override to display a single page.
 *
 * The doctype, html, head and body tags are not in this template. Instead they
 * can be found in the html.html.twig template in this directory.
 *
 * A workspace shell, not a CMS shell: one header strip, one navigation strip,
 * then the work. No sidebars, no help region, no secondary menu — those regions
 * do not exist in this theme (petrichor_theme.info.yml records why each one is
 * absent). The wrapper class names stay core's `.layout-container` /
 * `.layout-content` set rather than a bespoke `.petrichor-*` set: this is the
 * theme's own chrome, and anyone overriding this template should find the
 * structure they already know.
 *
 * Available variables:
 *
 * General utility variables:
 * - base_path: The base URL path of the Drupal installation. Will usually be
 *   "/" unless you have installed Drupal in a sub-directory.
 * - is_front: A flag indicating if the current page is the front page.
 * - logged_in: A flag indicating if the user is registered and signed in.
 * - is_admin: A flag indicating if the user has permission to access
 *   administration pages.
 * - is_workspace: TRUE on /pm* and /wiki* routes. Added by
 *   PetrichorThemeHooks::preprocessPage(); resolved from the route path, not
 *   the request URI, so it survives /pm becoming the site front page.
 *
 * Site identity:
 * - front_page: The URL of the front page. Use this instead of base_path when
 *   linking to the front page. This includes the language domain or prefix.
 *
 * Regions:
 * - page.header: Items for the header region.
 * - page.primary_menu: Items for the primary menu region.
 * - page.breadcrumb: Items for the breadcrumb region.
 * - page.highlighted: Status messages, local task tabs, local actions.
 * - page.content: The main content of the current page.
 * - page.footer: Items for the footer region.
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessPage()
 * @see \Drupal\petrichor_theme\Hook\PetrichorThemeHooks::preprocessPage()
 * @see html.html.twig
 */
#}
<div class="layout-container">

  <header>
    {{ page.header }}
  </header>

  {{ page.primary_menu }}

  {#
    Breadcrumbs are dropped from the markup on workspace routes rather than
    hidden in CSS. A breadcrumb is a <nav> landmark full of tab stops: hiding it
    visually leaves it in the accessibility tree and in the tab order, so a
    screen reader user is offered a trail a sighted user cannot see. On
    /pm/board/2 that trail is "Home › Board" — orientation nobody needs on the
    one screen they look at all day.

    The page title is the opposite call, made the opposite way: it stays in the
    DOM on every route because a page with no h1 is a real accessibility
    regression, and only its visual weight changes. See page-title.html.twig.
  #}
  {% if not is_workspace %}
    {{ page.breadcrumb }}
  {% endif %}

  {{ page.highlighted }}

  <main>
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    <div class="layout-content">
      {{ page.content }}
    </div>{# /.layout-content #}

  </main>

  {% if page.footer %}
    <footer>
      {{ page.footer }}
    </footer>
  {% endif %}

</div>{# /.layout-container #}
