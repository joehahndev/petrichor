# Third-party code. Composer resolves it from composer.json.
/vendor/

# Everything below is generated by ddev-drupal-contrib when you run the local
# CI harness (see README). It assembles a whole Drupal site around this module
# so the same checks drupal.org runs can run here first. None of it belongs in
# the module, and phpstan-baseline.neon in particular must never ship — it
# suppresses exactly the errors the pipeline exists to report.
/web/
/recipes/
/.ddev/
/.prettierrc.json
/phpcs.xml.dist
/phpstan-baseline.neon
/.editorconfig
/.gitattributes

# Editor and OS noise.
.DS_Store
*.swp
