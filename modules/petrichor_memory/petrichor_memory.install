<?php

/**
 * @file
 * Install hooks for Petrichor Memory.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Yaml;

/**
 * Implements hook_schema().
 *
 * Recall recency lives in a side table, not on the entity — otherwise every
 * recall (a read) becomes an entity save (a write), churning caches and the
 * changed timestamp that conflict detection relies on.
 */
function petrichor_memory_schema(): array {
  $schema['petrichor_memory_recall'] = [
    'description' => 'Tracks when each memory was last recalled.',
    'fields' => [
      'memory_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'last_recalled' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['memory_id'],
  ];
  return $schema;
}

/**
 * Adds the 'proposed' status so remember() can hold a memory for review.
 */
function petrichor_memory_update_11001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $field = $manager->getFieldStorageDefinition('status', 'petrichor_memory');
  if (!$field) {
    return 'No status field on petrichor_memory; nothing to update.';
  }

  // allowed_values does not change the column, so this is not a schema
  // migration — it re-stores the definition so Drupal's status report does
  // not flag the code and the database as disagreeing, and so any form built
  // from the stored definition offers the new option.
  $values = $field->getSetting('allowed_values');
  if (isset($values['proposed'])) {
    return 'The proposed status is already installed.';
  }
  $field->setSetting('allowed_values', [
    'proposed' => t('Proposed'),
    'active' => t('Active'),
    'archived' => t('Archived'),
  ]);
  $manager->updateFieldStorageDefinition($field);

  // Existing memories keep their status. Everything recorded before this
  // update was recorded under the old always-active behaviour, and silently
  // demoting it to 'proposed' would hide facts that sessions already rely on.
  return 'Added the proposed memory status. Existing memories are unchanged.';
}

/**
 * Installs the memory overview View, if petrichor_tags is already on.
 *
 * The view lives in config/optional and depends on both petrichor_memory
 * and petrichor_tags, so the normal path is Drupal's own mechanism: when a
 * module is newly enabled, every enabled module's config/optional is
 * rescanned for dependencies that are now satisfied. Installing
 * petrichor_tags after this update lands covers itself.
 *
 * This hook exists for the other order: a site where petrichor_tags was
 * already enabled before this view shipped, where nothing else triggers
 * that rescan. No memory data is touched — this only adds one config
 * object, and only if it is not already there.
 */
function petrichor_memory_update_11003(): string {
  if (!\Drupal::moduleHandler()->moduleExists('petrichor_tags')) {
    return 'petrichor_tags is not enabled; the memory overview view needs it and will install automatically once it is.';
  }
  if (\Drupal::configFactory()->get('views.view.petrichor_memory_overview')->isNew() === FALSE) {
    return 'The memory overview view already exists; nothing to do.';
  }

  $path = \Drupal::service('extension.list.module')->getPath('petrichor_memory')
    . '/config/optional/views.view.petrichor_memory_overview.yml';
  $data = Yaml::decode(file_get_contents($path));
  \Drupal::configFactory()->getEditable('views.view.petrichor_memory_overview')
    ->setData($data)
    ->save(TRUE);

  return 'Installed the memory overview view at /pm/memories.';
}

/**
 * Removes the native 'tags' field so petrichor_tags can take it over.
 *
 * Must run — and be run, via updatedb — before petrichor_tags is ever
 * enabled. Enabling a module auto-installs any base field it defines onto
 * every existing entity type as an unconditional first step of
 * ModuleInstaller::install(), before that module's own hook_install() gets
 * a chance to run. Finding a field named 'tags' already installed here (the
 * old string one), that auto-step overwrites the "last installed"
 * bookkeeping to the new type without touching the actual table — one
 * already exists under that name — leaving petrichor_tags_install() looking
 * at bookkeeping that already claims to be migrated, and a table that never
 * actually changed underneath it. Removing the old field first, in its own
 * update hook, leaves nothing for that auto-step to collide with by the
 * time petrichor_tags is installed.
 *
 * The old values are stashed in the keyvalue store, not migrated to terms
 * directly — this hook runs before petrichor_tags (and its vocabulary, and
 * its resolver service) exists at all. petrichor_tags_install() finishes
 * the job once it does.
 */
function petrichor_memory_update_11004(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $old_definition = $manager->getFieldStorageDefinition('tags', 'petrichor_memory');
  if (!$old_definition || $old_definition->getType() !== 'string') {
    return 'No native tags field on petrichor_memory; nothing to remove.';
  }

  $rows = \Drupal::database()->select('petrichor_memory__tags', 't')
    ->fields('t', ['entity_id', 'tags_value'])
    ->execute()
    ->fetchAll();
  $names_by_entity = [];
  foreach ($rows as $row) {
    $names_by_entity[(int) $row->entity_id][] = $row->tags_value;
  }

  \Drupal::keyValue('petrichor_tags_migration')->set('petrichor_memory', $names_by_entity);
  $manager->uninstallFieldStorageDefinition($old_definition);

  return sprintf(
    'Removed the native tags field from %d memories; petrichor_tags will finish migrating them once installed.',
    count($names_by_entity)
  );
}

/**
 * Re-syncs the memory overview View, fixing update 11003's stale-config gap.
 *
 * 11003 skipped syncing whenever a config object of this name already
 * existed — true on any site that had the memory overview View from before
 * petrichor_tags shipped (the original shape: a plain string tags column,
 * no tags filter), which is exactly the site 11003 was meant to fix. It
 * never distinguished "already has the current shape" from "still has the
 * old one", so those sites kept the pre-tags View forever, even after
 * petrichor_tags installed successfully and the field itself migrated
 * correctly underneath it — caught by checking the live page's rendered
 * markup after a real migration, not by re-reading the update hook.
 *
 * Unconditionally re-syncs the View from the config/optional file whenever
 * petrichor_tags is enabled, rather than trusting a config object's mere
 * existence — safe because this View is ours to own outright: nothing in
 * this project's own conventions has a site admin hand-customize it via
 * Views UI.
 */
function petrichor_memory_update_11005(): string {
  if (!\Drupal::moduleHandler()->moduleExists('petrichor_tags')) {
    return 'petrichor_tags is not enabled; the memory overview view needs it and will install automatically once it is.';
  }

  $path = \Drupal::service('extension.list.module')->getPath('petrichor_memory')
    . '/config/optional/views.view.petrichor_memory_overview.yml';
  $data = Yaml::decode(file_get_contents($path));
  \Drupal::configFactory()->getEditable('views.view.petrichor_memory_overview')
    ->setData($data)
    ->save(TRUE);

  return 'Re-synced the memory overview view at /pm/memories to the current shape.';
}
